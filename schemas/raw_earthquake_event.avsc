{
  "type": "record",
  "name": "RawEarthquakeEvent",
  "namespace": "com.rhonnydc.seismic",
  "fields": [
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "ISO 8601 timestamp in UTC."
    },
    {
      "name": "latitude",
      "type": "double"
    },
    {
      "name": "longitude",
      "type": "double"
    },
    {
      "name": "depth_km",
      "type": "double"
    },
    {
      "name": "magnitude",
      "type": "double"
    },
    {
      "name": "source",
      "type": "string"
    }
  ]
}
