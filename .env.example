# Application
APP_ENV=local
LOG_LEVEL=INFO

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_EARTHQUAKES_TOPIC=raw_earthquakes
KAFKA_ENRICHED_EARTHQUAKES_TOPIC=enriched_earthquakes
KAFKA_SEISMIC_METRICS_TOPIC=seismic_metrics
KAFKA_DEAD_LETTER_TOPIC=dead_letter_earthquakes

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8081

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seismic_analytics
POSTGRES_USER=seismic_user
POSTGRES_PASSWORD=seismic_password

# Kpow
KPOW_HOST=localhost
KPOW_PORT=3000

# Optional live earthquake API
EARTHQUAKE_API_URL=
EARTHQUAKE_API_TIMEOUT_SECONDS=10
